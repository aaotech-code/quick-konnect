generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  suspended
  banned
  pending
}

enum RoleName {
  admin
  manager
  support
  finance
  customer
  provider
}

enum ProviderVerificationStatus {
  new
  phone_verified
  identity_submitted
  pending
  verified
  rejected
  suspended
}

enum VerificationType {
  phone
  identity
  address
  business
  reference
}

enum VerificationStatus {
  pending
  approved
  rejected
  expired
}

enum RequestStatus {
  open
  closed
  expired
  cancelled
}

enum QuoteStatus {
  submitted
  accepted
  rejected
  withdrawn
  expired
}

enum PaymentMode {
  direct
  protected
}

enum JobStatus {
  provider_selected
  awaiting_payment
  payment_secured
  scheduled
  in_progress
  provider_marked_complete
  customer_confirmed
  payment_released
  completed
  cancelled
  disputed
}

enum PaymentStatus {
  pending
  successful
  failed
  secured
  release_pending
  released
  refunded
  disputed
}

enum PayoutStatus {
  pending
  processing
  paid
  failed
}

enum DisputeStatus {
  open
  under_review
  awaiting_evidence
  resolved_released
  resolved_refunded
  resolved_partial
  cancelled
}

enum ReviewStatus {
  published
  hidden
  pending
}

enum MediaScanStatus {
  pending
  clean
  infected
  failed
}

enum SettingValueType {
  boolean
  string
  number
  json
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  phone           String?          @unique
  passwordHash    String           @map("password_hash")
  status          UserStatus       @default(pending)
  emailVerifiedAt DateTime?        @map("email_verified_at")
  phoneVerifiedAt DateTime?        @map("phone_verified_at")
  lastLoginAt     DateTime?        @map("last_login_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")
  roles           UserRole[]
  sessions        Session[]
  customerProfile CustomerProfile?
  providerProfile ProviderProfile?
  auditLogs       AuditLog[]
  adminActions    AdminAction[]

  @@index([status])
  @@map("users")
}

model Role {
  id          String     @id @default(uuid())
  name        RoleName   @unique
  description String?
  createdAt   DateTime   @default(now()) @map("created_at")
  users       UserRole[]

  @@map("roles")
}

model UserRole {
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  grantedAt DateTime @default(now()) @map("granted_at")
  grantedBy String?  @map("granted_by")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Session {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  ip        String?
  userAgent String?   @map("user_agent")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("sessions")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

model OtpCode {
  id        String    @id @default(uuid())
  userId    String?   @map("user_id")
  phone     String
  codeHash  String    @map("code_hash")
  purpose   String
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([phone, purpose])
  @@map("otp_codes")
}

model LoginAttempt {
  id         String   @id @default(uuid())
  identifier String
  success    Boolean
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([identifier, createdAt])
  @@map("login_attempts")
}

model CustomerProfile {
  id                String    @id @default(uuid())
  userId            String    @unique @map("user_id")
  fullName          String    @map("full_name")
  avatarMediaId     String?   @map("avatar_media_id")
  defaultLocationId String?   @map("default_location_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultLocation   Location? @relation(fields: [defaultLocationId], references: [id])

  @@map("customer_profiles")
}

model ProviderProfile {
  id                 String                     @id @default(uuid())
  userId             String                     @unique @map("user_id")
  slug               String                     @unique
  businessName       String                     @map("business_name")
  tagline            String?
  description        String?
  yearsExperience    Int?                       @map("years_experience")
  logoMediaId        String?                    @map("logo_media_id")
  verificationStatus ProviderVerificationStatus @default(new) @map("verification_status")
  ratingAvg          Decimal                    @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount        Int                        @default(0) @map("rating_count")
  jobsCompleted      Int                        @default(0) @map("jobs_completed")
  responseRate       Decimal?                   @map("response_rate") @db.Decimal(5, 2)
  avgResponseMinutes Int?                       @map("avg_response_minutes")
  priceBandMin       Int?                       @map("price_band_min")
  priceBandMax       Int?                       @map("price_band_max")
  currency           String                     @default("NGN")
  languages          String[]                   @default([])
  isFeatured         Boolean                    @default(false) @map("is_featured")
  publishedAt        DateTime?                  @map("published_at")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")
  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  services           ProviderService[]
  locations          ProviderLocation[]
  portfolio          PortfolioItem[]
  categories         ProviderCategory[]
  verifications      ProviderVerification[]
  requestProviders   RequestProvider[]
  quotes             Quote[]
  jobs               Job[]

  @@index([verificationStatus, publishedAt])
  @@index([isFeatured])
  @@map("provider_profiles")
}

model ProviderService {
  id          String          @id @default(uuid())
  providerId  String          @map("provider_id")
  categoryId  String          @map("category_id")
  title       String
  description String?
  priceType   String          @default("quote") @map("price_type")
  priceMin    Int?            @map("price_min")
  priceMax    Int?            @map("price_max")
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at")
  provider    ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category    ServiceCategory @relation(fields: [categoryId], references: [id])

  @@index([categoryId, isActive])
  @@map("provider_services")
}

model ProviderLocation {
  id             String          @id @default(uuid())
  providerId     String          @map("provider_id")
  locationId     String          @map("location_id")
  servesRadiusKm Int?            @map("serves_radius_km")
  isPrimary      Boolean         @default(false) @map("is_primary")
  provider       ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  location       Location        @relation(fields: [locationId], references: [id])

  @@unique([providerId, locationId])
  @@map("provider_locations")
}

model PortfolioItem {
  id          String          @id @default(uuid())
  providerId  String          @map("provider_id")
  title       String?
  description String?
  mediaId     String          @map("media_id")
  sortOrder   Int             @default(0) @map("sort_order")
  createdAt   DateTime        @default(now()) @map("created_at")
  provider    ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  media       Media           @relation(fields: [mediaId], references: [id])

  @@index([providerId, sortOrder])
  @@map("portfolio_items")
}

model ProviderCategory {
  providerId String          @map("provider_id")
  categoryId String          @map("category_id")
  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category   ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([providerId, categoryId])
  @@map("provider_categories")
}

model ServiceCategory {
  id                 String             @id @default(uuid())
  parentId           String?            @map("parent_id")
  name               String
  slug               String             @unique
  imageUrl    String?  @map("image_url")
  description        String?
  icon               String?
  sortOrder          Int                @default(0) @map("sort_order")
  isActive           Boolean            @default(true) @map("is_active")
  createdAt          DateTime           @default(now()) @map("created_at")
  parent             ServiceCategory?   @relation("CategoryTree", fields: [parentId], references: [id])
  children           ServiceCategory[]  @relation("CategoryTree")
  providerServices   ProviderService[]
  providerCategories ProviderCategory[]
  serviceRequests    ServiceRequest[]

  @@index([parentId, isActive, sortOrder])
  @@map("service_categories")
}

model Location {
  id                String             @id @default(uuid())
  parentId          String?            @map("parent_id")
  type              String
  name              String
  slug              String
  lat               Decimal?           @db.Decimal(9, 6)
  lng               Decimal?           @db.Decimal(9, 6)
  isActive          Boolean            @default(true) @map("is_active")
  isFeatured Boolean @default(false) @map("is_featured")
  createdAt         DateTime           @default(now()) @map("created_at")
  parent            Location?          @relation("LocationTree", fields: [parentId], references: [id])
  children          Location[]         @relation("LocationTree")
  providerLocations ProviderLocation[]
  serviceRequests   ServiceRequest[]
  customerProfiles  CustomerProfile[]

  @@unique([parentId, slug])
  @@index([type, isActive])
  @@map("locations")
}

model ProviderVerification {
  id              String             @id @default(uuid())
  providerId      String             @map("provider_id")
  type            VerificationType
  status          VerificationStatus @default(pending)
  documentMediaId String?            @map("document_media_id")
  selfieMediaId   String?            @map("selfie_media_id")
  submittedAt     DateTime           @default(now()) @map("submitted_at")
  reviewedBy      String?            @map("reviewed_by")
  reviewedAt      DateTime?          @map("reviewed_at")
  notes           String?
  provider        ProviderProfile    @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, type, status])
  @@map("provider_verifications")
}

model ServiceRequest {
  id                  String              @id @default(uuid())
  publicRef           String              @unique @map("public_ref")
  customerId          String              @map("customer_id")
  categoryId          String              @map("category_id")
  title               String
  description         String
  locationId          String              @map("location_id")
  addressText         String?             @map("address_text")
  preferredDate       DateTime?           @map("preferred_date")
  preferredTimeWindow String?             @map("preferred_time_window")
  budgetMin           Int?                @map("budget_min")
  budgetMax           Int?                @map("budget_max")
  status              RequestStatus       @default(open)
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  category            ServiceCategory     @relation(fields: [categoryId], references: [id])
  location            Location            @relation(fields: [locationId], references: [id])
  attachments         RequestAttachment[]
  providers           RequestProvider[]
  quotes              Quote[]
  job                 Job?

  @@index([status, createdAt])
  @@index([customerId, status])
  @@index([categoryId, locationId, status])
  @@map("service_requests")
}

model RequestAttachment {
  id         String         @id @default(uuid())
  requestId  String         @map("request_id")
  mediaId    String         @map("media_id")
  uploadedBy String         @map("uploaded_by")
  createdAt  DateTime       @default(now()) @map("created_at")
  request    ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  media      Media          @relation(fields: [mediaId], references: [id])

  @@map("request_attachments")
}

model RequestProvider {
  requestId     String          @map("request_id")
  providerId    String          @map("provider_id")
  invitedAt     DateTime        @default(now()) @map("invited_at")
  viewedAt      DateTime?       @map("viewed_at")
  declinedAt    DateTime?       @map("declined_at")
  declineReason String?         @map("decline_reason")
  request       ServiceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider      ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@id([requestId, providerId])
  @@index([providerId, declinedAt])
  @@map("request_providers")
}

model Quote {
  id                String            @id @default(uuid())
  requestId         String            @map("request_id")
  providerId        String            @map("provider_id")
  amountKobo        Int               @map("amount_kobo")
  currency          String            @default("NGN")
  durationEstimate  String?           @map("duration_estimate")
  description       String
  materialsIncluded Boolean           @default(false) @map("materials_included")
  materialsNotes    String?           @map("materials_notes")
  conditions        String?
  availableFrom     DateTime?         @map("available_from")
  expiresAt         DateTime?         @map("expires_at")
  status            QuoteStatus       @default(submitted)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  request           ServiceRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider          ProviderProfile   @relation(fields: [providerId], references: [id])
  attachments       QuoteAttachment[]
  job               Job?

  @@unique([requestId, providerId])
  @@index([providerId, status])
  @@map("quotes")
}

model QuoteAttachment {
  id      String @id @default(uuid())
  quoteId String @map("quote_id")
  mediaId String @map("media_id")
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  media   Media  @relation(fields: [mediaId], references: [id])

  @@map("quote_attachments")
}

model Job {
  id                   String             @id @default(uuid())
  publicRef            String             @unique @map("public_ref")
  requestId            String             @unique @map("request_id")
  quoteId              String             @unique @map("quote_id")
  customerId           String             @map("customer_id")
  providerId           String             @map("provider_id")
  agreedAmountKobo     Int                @map("agreed_amount_kobo")
  currency             String             @default("NGN")
  paymentMode          PaymentMode        @default(direct) @map("payment_mode")
  status               JobStatus          @default(provider_selected)
  commissionRate       Decimal            @default(10.00) @map("commission_rate") @db.Decimal(5, 2)
  commissionAmountKobo Int                @default(0) @map("commission_amount_kobo")
  scheduledAt          DateTime?          @map("scheduled_at")
  startedAt            DateTime?          @map("started_at")
  providerCompletedAt  DateTime?          @map("provider_completed_at")
  customerConfirmedAt  DateTime?          @map("customer_confirmed_at")
  cancelledAt          DateTime?          @map("cancelled_at")
  cancelReason         String?            @map("cancel_reason")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  request              ServiceRequest     @relation(fields: [requestId], references: [id])
  quote                Quote              @relation(fields: [quoteId], references: [id])
  provider             ProviderProfile    @relation(fields: [providerId], references: [id])
  statusHistory        JobStatusHistory[]
  threads              MessageThread[]
  payments             Payment[]
  payouts              Payout[]
  disputes             Dispute[]
  reviews              Review[]

  @@index([customerId, status])
  @@index([providerId, status])
  @@index([status, createdAt])
  @@map("jobs")
}

model JobStatusHistory {
  id         String     @id @default(uuid())
  jobId      String     @map("job_id")
  fromStatus JobStatus? @map("from_status")
  toStatus   JobStatus  @map("to_status")
  changedBy  String     @map("changed_by")
  note       String?
  createdAt  DateTime   @default(now()) @map("created_at")
  job        Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@map("job_status_history")
}

model MessageThread {
  id                String    @id @default(uuid())
  customerId        String    @map("customer_id")
  providerId        String    @map("provider_id")
  jobId             String?   @map("job_id")
  requestId         String?   @map("request_id")
  lastMessageAt     DateTime  @default(now()) @map("last_message_at")
  readByCustomerAt  DateTime? @map("read_by_customer_at")
  readByProviderAt  DateTime? @map("read_by_provider_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  job      Job?      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  messages Message[]
  @@unique([customerId, providerId])
  @@index([customerId, lastMessageAt])
  @@index([providerId, lastMessageAt])
  @@map("message_threads")
}

model Message {
  id          String              @id @default(uuid())
  threadId    String              @map("thread_id")
  senderId    String              @map("sender_id")
  body        String
  readAt      DateTime?           @map("read_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  thread      MessageThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  attachments MessageAttachment[]

  @@index([threadId, createdAt])
  @@map("messages")
}

model MessageAttachment {
  id        String  @id @default(uuid())
  messageId String  @map("message_id")
  mediaId   String  @map("media_id")
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  media     Media   @relation(fields: [mediaId], references: [id])

  @@map("message_attachments")
}

model Payment {
  id             String         @id @default(uuid())
  jobId          String         @map("job_id")
  payerId        String         @map("payer_id")
  internalRef    String         @unique @map("internal_ref")
  providerTxnRef String?        @unique @map("provider_txn_ref")
  amountKobo     Int            @map("amount_kobo")
  currency       String         @default("NGN")
  status         PaymentStatus  @default(pending)
  channel        String?
  checkoutUrl    String?        @map("checkout_url")
  initAttempts   Int            @default(0) @map("init_attempts")
  lastInitError  String?        @map("last_init_error")
  metadata       Json           @default("{}")
  paidAt         DateTime?      @map("paid_at")
  securedAt      DateTime?      @map("secured_at")
  releasedAt     DateTime?      @map("released_at")
  refundedAt     DateTime?      @map("refunded_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  job            Job            @relation(fields: [jobId], references: [id])
  events         PaymentEvent[]
  ledger         LedgerEntry[]
  payouts        Payout[]

  @@index([jobId, status])
  @@index([status, createdAt])
  @@map("payments")
}

model PaymentEvent {
  id                String    @id @default(uuid())
  paymentId         String?   @map("payment_id")
  providerEventId   String    @unique @map("provider_event_id")
  eventType         String    @map("event_type")
  signatureVerified Boolean   @map("signature_verified")
  payload           Json
  processedAt       DateTime? @map("processed_at")
  processingError   String?   @map("processing_error")
  createdAt         DateTime  @default(now()) @map("created_at")
  payment           Payment?  @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("payment_events")
}

model LedgerEntry {
  id         String   @id @default(uuid())
  paymentId  String   @map("payment_id")
  jobId      String   @map("job_id")
  account    String
  direction  String
  amountKobo Int      @map("amount_kobo")
  currency   String   @default("NGN")
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")
  payment    Payment  @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@index([jobId])
  @@index([account, createdAt])
  @@map("ledger_entries")
}

model Payout {
  id                  String       @id @default(uuid())
  providerId          String       @map("provider_id")
  jobId               String       @map("job_id")
  paymentId           String       @map("payment_id")
  amountKobo          Int          @map("amount_kobo")
  currency            String       @default("NGN")
  status              PayoutStatus @default(pending)
  providerTransferRef String?      @unique @map("provider_transfer_ref")
  recipientCode       String?      @map("recipient_code")
  attempts            Int          @default(0)
  lastError           String?      @map("last_error")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")
  job                 Job          @relation(fields: [jobId], references: [id])
  payment             Payment      @relation(fields: [paymentId], references: [id])

  @@index([status, createdAt])
  @@index([providerId, status])
  @@map("payouts")
}

model Dispute {
  id                  String            @id @default(uuid())
  jobId               String            @map("job_id")
  paymentId           String?           @map("payment_id")
  openedBy            String            @map("opened_by")
  reasonCode          String            @map("reason_code")
  description         String
  requestedResolution String            @map("requested_resolution")
  status              DisputeStatus     @default(open)
  resolution          String?
  resolvedBy          String?           @map("resolved_by")
  resolvedAt          DateTime?         @map("resolved_at")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  job                 Job               @relation(fields: [jobId], references: [id])
  evidence            DisputeEvidence[]

  @@index([status, createdAt])
  @@map("disputes")
}

model DisputeEvidence {
  id         String   @id @default(uuid())
  disputeId  String   @map("dispute_id")
  uploadedBy String   @map("uploaded_by")
  mediaId    String?  @map("media_id")
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")
  dispute    Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  media      Media?   @relation(fields: [mediaId], references: [id])

  @@map("dispute_evidence")
}

model PlatformSetting {
  key         String           @id
  valueType   SettingValueType @map("value_type")
  value       Json
  description String?
  updatedBy   String?          @map("updated_by")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  @@map("platform_settings")
}

model SettingChangeLog {
  id                String   @id @default(uuid())
  key               String
  previousValue     Json?    @map("previous_value")
  newValue          Json     @map("new_value")
  actorId           String   @map("actor_id")
  reason            String
  ipAddress         String?  @map("ip_address")
  userAgent         String?  @map("user_agent")
  readinessSnapshot Json?    @map("readiness_snapshot")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([key, createdAt])
  @@map("setting_change_log")
}

model ProtectedPaymentReadiness {
  id                      Int       @id @default(1)
  legalReviewStatus       String    @default("pending") @map("legal_review_status")
  legalReviewRef          String?   @map("legal_review_ref")
  legalReviewAt           DateTime? @map("legal_review_at")
  providerApprovalStatus  String    @default("pending") @map("provider_approval_status")
  providerApprovalRef     String?   @map("provider_approval_ref")
  providerApprovalAt      DateTime? @map("provider_approval_at")
  complianceStatus        String    @default("pending") @map("compliance_status")
  complianceRef           String?   @map("compliance_ref")
  complianceAt            DateTime? @map("compliance_at")
  operationalReviewStatus String    @default("pending") @map("operational_review_status")
  operationalReviewRef    String?   @map("operational_review_ref")
  operationalReviewAt     DateTime? @map("operational_review_at")
  notes                   String?
  updatedBy               String?   @map("updated_by")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  @@map("protected_payment_readiness")
}

model Review {
  id                    String          @id @default(uuid())
  jobId                 String          @unique @map("job_id")
  providerId            String          @map("provider_id")
  customerId            String          @map("customer_id")
  ratingOverall         Int             @map("rating_overall")
  ratingQuality         Int?            @map("rating_quality")
  ratingProfessionalism Int?            @map("rating_professionalism")
  ratingCommunication   Int?            @map("rating_communication")
  ratingTimeliness      Int?            @map("rating_timeliness")
  ratingValue           Int?            @map("rating_value")
  body                  String?
  status                ReviewStatus    @default(published)
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")
  job                   Job             @relation(fields: [jobId], references: [id])
  response              ReviewResponse?

  @@index([providerId, status, createdAt])
  @@map("reviews")
}

model ReviewResponse {
  id         String   @id @default(uuid())
  reviewId   String   @unique @map("review_id")
  providerId String   @map("provider_id")
  body       String
  createdAt  DateTime @default(now()) @map("created_at")
  review     Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("review_responses")
}

model Media {
  id                 String              @id @default(uuid())
  ownerId            String              @map("owner_id")
  storageKey         String              @unique @map("storage_key")
  mime               String
  sizeBytes          Int                 @map("size_bytes")
  checksum           String?
  scanStatus         MediaScanStatus     @default(pending) @map("scan_status")
  width              Int?
  height             Int?
  createdAt          DateTime            @default(now()) @map("created_at")
  portfolioItems     PortfolioItem[]
  requestAttachments RequestAttachment[]
  quoteAttachments   QuoteAttachment[]
  messageAttachments MessageAttachment[]
  disputeEvidence    DisputeEvidence[]

  @@index([ownerId])
  @@map("media")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      String
  title     String
  body      String
  data      Json      @default("{}")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model Favorite {
  customerId String   @map("customer_id")
  providerId String   @map("provider_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@id([customerId, providerId])
  @@map("favorites")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  event      String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  ip         String?
  userAgent  String?  @map("user_agent")
  meta       Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model AdminAction {
  id         String   @id @default(uuid())
  adminId    String   @map("admin_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")
  admin      User     @relation(fields: [adminId], references: [id])

  @@index([adminId, createdAt])
  @@map("admin_actions")
}
